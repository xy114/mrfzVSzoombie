{
  "author": "xy <3411135364@qq.com>",
  "name": "mrfz-vs-zombie",
  "version": "2.1.0",
  "description": "Plant vs Zombie style tower defense game",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "node scripts/build.js --win --x64",
    "build:win:portable": "node scripts/build.js --win portable --x64",
    "build:mac": "node scripts/build.js --mac --x64",
    "build:all": "node scripts/build.js --win --mac --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "24.13.3",
    "electron-packager": "^17.1.2",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.mrfz.vszombie",
    "productName": "PvZ Tactics",
    "artifactName": "植物大战僵尸-${version}-${env.BUILD_TIME}-${os}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!assets/**/*.md",
      "!rowvideos/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["zh_CN", "en_US"]
    },
    "mac": {
      "category": "public.app-category.games",
      "extendInfo": {
        "CFBundleDisplayName": "植物大战僵尸",
        "CFBundleName": "PvZ Tactics"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "PvZ Tactics ${version}"
    }
  },
  "dependencies": {
    "gifuct-js": "^2.1.2"
  }
}
